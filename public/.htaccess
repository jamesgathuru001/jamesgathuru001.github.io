# SPA fallback (Apache / cPanel — see PLAN.md §9 for the intended host).
# Serves real files and directories as-is; everything else falls through to the
# app so /work survives a direct hit or a refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
